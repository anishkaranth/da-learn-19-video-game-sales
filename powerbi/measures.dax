// _Measures table - video game sales (units in MILLIONS)
Units Sold (M) = SUM ( fact_game_sales[global_sales] )
NA Units (M) = SUM ( fact_game_sales[na_sales] )
EU Units (M) = SUM ( fact_game_sales[eu_sales] )
JP Units (M) = SUM ( fact_game_sales[jp_sales] )
Other Units (M) = SUM ( fact_game_sales[other_sales] )
Titles = COUNTROWS ( fact_game_sales )
Distinct Games = DISTINCTCOUNT ( fact_game_sales[title] )
Avg Units per Title (M) = DIVIDE ( [Units Sold (M)], [Titles] )
Median Units per Title (M) = MEDIAN ( fact_game_sales[global_sales] )
Million Sellers = CALCULATE ( [Titles], fact_game_sales[is_million_seller] = 1 )
Million Seller % = DIVIDE ( [Million Sellers], [Titles] )
NA Share % = DIVIDE ( [NA Units (M)], [NA Units (M)] + [EU Units (M)] + [JP Units (M)] + [Other Units (M)] )
JP Share % = DIVIDE ( [JP Units (M)], [NA Units (M)] + [EU Units (M)] + [JP Units (M)] + [Other Units (M)] )
Share of All Units % = DIVIDE ( [Units Sold (M)], CALCULATE ( [Units Sold (M)], ALL ( fact_game_sales ) ) )
Share of Genre JP % = DIVIDE ( [JP Units (M)], CALCULATE ( [JP Units (M)], ALL ( dim_genre ) ) )
Avg Critic Score = AVERAGE ( fact_game_sales[critic_score] )
Critic Score Coverage % = DIVIDE ( COUNT ( fact_game_sales[critic_score] ), [Titles] )
Publisher Rank = RANKX ( ALL ( dim_publisher ), [Units Sold (M)], , DESC, DENSE )
Units (Trend Years) (M) = CALCULATE ( [Units Sold (M)], dim_year[release_year] >= 1980, dim_year[release_year] <= 2016 )
